# ── Next.js Storefront Environment Variables ──

# Medusa backend URL (server-side requests from Next.js)
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa (created during seeding)
# After running the seed script, get the real key from:
#   - Medusa Admin > Settings > API Keys > Publishable Keys
#   - Or via API: curl http://localhost:9000/admin/api-keys?type=publishable
# The middleware WILL FAIL if this is not a valid key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Runtime publishable key (overrides NEXT_PUBLIC_* at runtime for server-side code)
# This is used by the middleware and server actions. Set this to the same value.
MEDUSA_PUBLISHABLE_KEY=

# Base URL of the storefront itself
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region code (must match a country in a Medusa region)
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe (optional — leave empty to use default system payment provider)
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Payments plugin (optional)
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Cache revalidation secret
REVALIDATE_SECRET=supersecret

# S3 image hosting (optional, for Medusa Cloud)
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
