# ── Medusa Backend Environment Variables ──
# Copy this file to .env and fill in values for your environment.

# Database - REQUIRED (PostgreSQL connection string)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# Redis - REQUIRED for caching, events, and pub/sub
REDIS_URL=redis://localhost:6379

# CORS Origins (comma-separated)
# STORE_CORS: origins allowed to call /store/* endpoints
STORE_CORS=http://localhost:8000,http://localhost:3000,https://docs.medusajs.com

# ADMIN_CORS: origins allowed to call /admin/* endpoints
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:7001,https://docs.medusajs.com

# AUTH_CORS: origins allowed to call /auth/* endpoints (login, register, etc.)
# MUST include BOTH admin AND storefront URLs
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,http://localhost:3000,http://localhost:7001,https://docs.medusajs.com

# Secrets (change these in production!)
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Admin user (created on first startup)
ADMIN_EMAIL=admin@medusa.local
ADMIN_PASSWORD=supersecret
